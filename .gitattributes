# Normalise line endings to LF in the repository.
* text=auto eol=lf

# Binary files: never diffed or merged as text.
*.png binary
*.jpg binary
*.jpeg binary
*.icns binary
*.pdf binary

# Generated by XcodeGen from native/App/project.yml: collapsed in diffs. On a conflict, run `make project`.
*.pbxproj linguist-generated=true -diff
