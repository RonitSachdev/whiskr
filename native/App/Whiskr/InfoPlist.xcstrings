    "NSAppleEventsUsageDescription": {
      "comment": "Info.plist: NSAppleEventsUsageDescription",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running in one of your terminals wants to control another app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルで実行中のプログラムが、別のアプリを操作しようとしています。"
          }
        }
      }
    },
    "NSDesktopFolderUsageDescription": {
      "comment": "Info.plist: NSDesktopFolderUsageDescription",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running in one of your terminals wants to use files in your Desktop folder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルで実行中のプログラムが、デスクトップフォルダのファイルを使おうとしています。"
          }
        }
      }
    },
    "NSDocumentsFolderUsageDescription": {
      "comment": "Info.plist: NSDocumentsFolderUsageDescription",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running in one of your terminals wants to use files in your Documents folder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルで実行中のプログラムが、書類フォルダのファイルを使おうとしています。"
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription": {
      "comment": "Info.plist: NSDownloadsFolderUsageDescription",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running in one of your terminals wants to use files in your Downloads folder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルで実行中のプログラムが、ダウンロードフォルダのファイルを使おうとしています。"
          }
        }
      }
    },
    "NSHumanReadableCopyright": {
      "comment": "Info.plist: NSHumanReadableCopyright (the About panel's copyright line; the app's name and the year, the same in every language)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "© 2026 Whiskr contributors"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "© 2026 Whiskr contributors"
          }
        }
      },
      "shouldTranslate": false
    },
    "NSLocationUsageDescription": {
      "comment": "Info.plist: NSLocationUsageDescription",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real weather in the meadow uses your location, rounded to about a kilometre, to ask Open-Meteo for the weather where you are. Sunrise and sunset are also worked out from it, on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "草原の実際の天気は、約1 kmに丸めた現在地を使ってOpen-Meteoに天気を問い合わせます。日の出と日の入りも、このMacでこの現在地から計算します。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Info.plist: NSLocationWhenInUseUsageDescription",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real weather in the meadow uses your location, rounded to about a kilometre, to ask Open-Meteo for the weather where you are. Sunrise and sunset are also worked out from it, on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "草原の実際の天気は、約1 kmに丸めた現在地を使ってOpen-Meteoに天気を問い合わせます。日の出と日の入りも、このMacでこの現在地から計算します。"
          }
        }
      }
    },
    "NSNetworkVolumesUsageDescription": {
      "comment": "Info.plist: NSNetworkVolumesUsageDescription",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running in one of your terminals wants to use files on a network volume."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルで実行中のプログラムが、ネットワークボリューム上のファイルを使おうとしています。"
          }
        }
      }
    },
    "NSRemovableVolumesUsageDescription": {
      "comment": "Info.plist: NSRemovableVolumesUsageDescription",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program running in one of your terminals wants to use files on a removable volume."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルで実行中のプログラムが、リムーバブルボリューム上のファイルを使おうとしています。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
