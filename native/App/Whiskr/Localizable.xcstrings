{
  "sourceLanguage": "en",
  "strings": {
    "!": {
      "shouldTranslate": false
    },
    "$ ": {
      "shouldTranslate": false
    },
    "%@ (%@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）"
          }
        }
      }
    },
    "%@ (⌘%lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (⌘%2$lld)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（⌘%2$lld）"
          }
        }
      }
    },
    "%@ has a dark version only, so the app stays dark while it is chosen.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にはダーク版しかないため、選んでいる間はアプリもダークのままになります。"
          }
        }
      }
    },
    "%@ has a light version only, so the app stays light while it is chosen.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にはライト版しかないため、選んでいる間はアプリもライトのままになります。"
          }
        }
      }
    },
    "%@ theme": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@テーマ"
          }
        }
      }
    },
    "%@ theme, selected": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@テーマ、選択中"
          }
        }
      }
    },
    "%@ · %lld tabs": {
      "comment": "Hover label of a workspace: its folder and how many tabs",
