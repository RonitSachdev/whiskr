{
  "sourceLanguage": "en",
  "strings": {
    "!": {
      "shouldTranslate": false
    },
    "$ ": {
      "shouldTranslate": false
    },
    "%@ (%@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）"
          }
        }
      }
    },
    "%@ (⌘%lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (⌘%2$lld)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（⌘%2$lld）"
          }
        }
      }
    },
    "%@ has a dark version only, so the app stays dark while it is chosen.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にはダーク版しかないため、選んでいる間はアプリもダークのままになります。"
          }
        }
      }
    },
    "%@ has a light version only, so the app stays light while it is chosen.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にはライト版しかないため、選んでいる間はアプリもライトのままになります。"
          }
        }
      }
    },
    "%@ theme": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@テーマ"
          }
        }
      }
    },
    "%@ theme, selected": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@テーマ、選択中"
          }
        }
      }
    },
    "%@ · %lld tabs": {
      "comment": "Hover label of a workspace: its folder and how many tabs",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ · %lld tab"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ · %lld tabs"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld個のタブ"
          }
        }
      }
    },
    "%@ · Changes": {
      "comment": "Tab title: a file's changes",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 変更"
          }
        }
      }
    },
    "%@ · Staged": {
      "comment": "Tab title: a file's staged changes",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · ステージ済み"
          }
        }
      }
    },
    "%@ · answer it in the terminal (⌘↩)": {
      "comment": "Answer card footer when it cannot be answered here",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · ターミナルで答えてください（⌘↩）"
