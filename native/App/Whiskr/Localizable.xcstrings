    },
    "“%@” changed on disk. Keep yours, or reload it? The other is kept in My Meadows.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」がディスク上で変更されました。自分の版を残しますか、再読み込みしますか? もう一方はマイ草原ライブラリに残ります。"
          }
