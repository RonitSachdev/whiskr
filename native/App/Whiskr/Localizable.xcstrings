    "“%@” was moved out of the Meadows folder, so the Default is shown.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」が Meadows フォルダから移動されたため、デフォルトを表示しています。"
          }
        }
      }
    },
    "↩ Create · Esc Cancel": {
      "comment": "New Worktree: its keys",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "↩ 作成 · Esc キャンセル"
          }
        }
      }
