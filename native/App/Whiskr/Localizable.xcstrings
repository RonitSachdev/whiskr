    "%@, %@ · updated %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$@ · updated %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、%2$@ · %3$@に更新"
          }
        }
      }
