    "%lld Claudes and %lld commands are running. They will stop. Claude conversations reopen where you left them.": {
      "comment": "Quit and Stop All Terminals alert body: how many Claudes and other programs are running",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@claudes@ and %#@commands@ are running. They will stop. Claude conversations reopen where you left them."
          },
          "substitutions": {
            "claudes": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Claude"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Claudes"
                    }
                  }
                }
              }
            },
            "commands": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg command"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg commands"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude %1$lld件とコマンド%2$lld件が実行中です。これらは停止します。Claudeの会話は中断したところから再開できます。"
          }
        }
      }
    },
    "%lld Claudes are running. They will stop; their conversations reopen where you left them.": {
      "comment": "Quit and Stop All Terminals alert body: only Claudes are running",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Claude is running. It will stop; its conversation reopens where you left it."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Claudes are running. They will stop; their conversations reopen where you left them."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude %lld件が実行中です。停止されますが、会話は中断したところから再開できます。"
          }
        }
      }
    },
