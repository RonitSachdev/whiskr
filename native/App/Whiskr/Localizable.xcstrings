    "%@, %lld changed files": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、変更されたファイル %2$lld 件"
          }
        }
      }
    },
    "%@: %@": {
      "comment": "Dock menu: a workspace and what waits there",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$@"
          }
        }
      },
      "shouldTranslate": false
    },
    "%@: every open workspace is in this menu (⌥⌘1…9) and in the meadow": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：開いているワークスペースはすべてこのメニュー（⌥⌘1…9）と草原にあります"
          }
        }
      }
    },
    "%lld Claudes": {
      "comment": "Status line: how many Claudes are running",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude %lld件"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Claude"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Claudes"
                }
              }
            }
          }
        }
      }
    },
    "%lld Claudes and %lld commands are running. They will stop. Claude conversations reopen where you left them.": {
      "comment": "Quit and Stop All Terminals alert body: how many Claudes and other programs are running",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@claudes@ and %#@commands@ are running. They will stop. Claude conversations reopen where you left them."
          },
          "substitutions": {
            "claudes": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Claude"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Claudes"
                    }
                  }
                }
              }
            },
            "commands": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg command"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg commands"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude %1$lld件とコマンド%2$lld件が実行中です。これらは停止します。Claudeの会話は中断したところから再開できます。"
          }
        }
      }
    },
    "%lld Claudes are running. They will stop; their conversations reopen where you left them.": {
      "comment": "Quit and Stop All Terminals alert body: only Claudes are running",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Claude is running. It will stop; its conversation reopens where you left it."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Claudes are running. They will stop; their conversations reopen where you left them."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude %lld件が実行中です。停止されますが、会話は中断したところから再開できます。"
          }
        }
      }
    },
    "%lld Claudes were not resumed here, so none runs twice: they may still be running there.": {
      "comment": "Launch notice: Claude conversations not resumed because the other version's host may still run them",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude %lld件は二重に動かないよう、ここでは再開していません。そちらでまだ動いている可能性があります。"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Claude was not resumed here, so it does not run twice: it may still be running there."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Claudes were not resumed here, so none runs twice: they may still be running there."
                }
              }
            }
          }
        }
      }
    },
