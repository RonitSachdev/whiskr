        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（⌘%2$lld）"
          }
        }
      }
    },
    "%@ has a dark version only, so the app stays dark while it is chosen.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にはダーク版しかないため、選んでいる間はアプリもダークのままになります。"
          }
        }
      }
    },
    "%@ has a light version only, so the app stays light while it is chosen.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にはライト版しかないため、選んでいる間はアプリもライトのままになります。"
          }
        }
      }
    },
    "%@ ready to place. Click where it should stand; press Return to place it at the cursor.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を置けます。置きたい場所をクリックするか、Returnでカーソルの位置に置きます。"
          }
        }
      }
    },
