    "%lld terminals started by a different version of Whiskr keep running in the background. This version cannot show them. They stay until their programs end; open that version to see them again.": {
      "comment": "Launch notice: how many terminals an incompatible session host holds",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のバージョンの Whiskr で開始したターミナル %lld 個がバックグラウンドで実行を続けています。このバージョンでは表示できません。プログラムが終了するまで残ります。再び表示するには、そのバージョンを開いてください。"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld terminal started by a different version of Whiskr keeps running in the background. This version cannot show it. It stays until its program ends; open that version to see it again."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld terminals started by a different version of Whiskr keep running in the background. This version cannot show them. They stay until their programs end; open that version to see them again."
                }
              }
            }
          }
        }
      }
    },
    "%lld/%lld": {
      "localizations": {
