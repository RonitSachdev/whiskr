      "comment": "Answer card footer",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · ⌘↩ ターミナルへ"
          }
        }
      }
    },
    "%@ ×%lld": {
      "comment": "Story view: a tool and how many times it was used",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ ×%2$lld"
          }
