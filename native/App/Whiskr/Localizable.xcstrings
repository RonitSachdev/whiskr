    "Done": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        }
      }
    },
    "Done (⌘↩)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
